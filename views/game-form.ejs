<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>Game Form</title>
</head>

<body>
    <h1>Add a New Game</h1>

    <form action="/games/new" method="POST">
        <div>
            <label for="title">Title:</label>
            <input type="text" id="title" name="title" maxlength="255" required>
        </div>

        <div>
            <label for="description">Description:</label>
            <textarea id="description" name="description"></textarea>
        </div>

        <div>
            <label for="price">Price:</label>
            <input type="number" id="price" name="price" min="0" step="0.01" required>
        </div>

        <div>
            <label for="stock">Stock:</label>
            <input type="number" id="stock" name="stock" min="0" step="1" required>
        </div>

        <div>
            <label for="image_url">Image URL:</label>
            <input type="url" id="image_url" name="image_url">
        </div>

        <div>
            <label for="publisher_id">Publisher ID:</label>
            <input type="number" id="publisher_id" name="publisher_id" min="1">
        </div>

        <div>
            <label for="genre_id">Genre ID:</label>
            <input type="number" id="genre_id" name="genre_id" min="1">
        </div>

        <div>
            <label for="release_year">Release Year:</label>
            <input type="number" id="release_year" name="release_year" min="1950" max="2100" step="1">
        </div>

        <button type="submit">Add Game</button>
    </form>

    <p><a href="/games">Back to games</a></p>

</body>

</html>