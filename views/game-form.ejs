<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title><%= game ? "Edit Game" : "Game Form" %></title>
</head>

<body>
    <h1><%= game ? "Edit Game" : "Add a New Game" %></h1>

    <% const checkedGenreIds = selectedGenreIds || []; %>

    <form action="<%= game ? `/games/${game.id}/edit` : "/games/new" %>" method="POST">
        <div>
            <label for="title">Title:</label>
            <input type="text" id="title" name="title" maxlength="255" value="<%= game?.title ?? "" %>" required>
        </div>

        <div>
            <label for="description">Description:</label>
            <textarea id="description" name="description"><%= game?.description ?? "" %></textarea>
        </div>

        <div>
            <label for="price">Price:</label>
            <input type="number" id="price" name="price" min="0" step="0.01" value="<%= game?.price ?? "" %>" required>
        </div>

        <div>
            <label for="stock">Stock:</label>
            <input type="number" id="stock" name="stock" min="0" step="1" value="<%= game?.stock ?? "" %>" required>
        </div>

        <div>
            <label for="image_url">Image URL:</label>
            <input type="url" id="image_url" name="image_url" value="<%= game?.image_url ?? "" %>">
        </div>

        <div>
            <label for="publisher_id">Publisher ID:</label>
            <input type="number" id="publisher_id" name="publisher_id" min="1" value="<%= game?.publisher_id ?? "" %>">
        </div>

        <div>
            <label for="genre_ids">Genres:</label>
            <select id="genre_ids" name="genre_ids" multiple>
                <% genres.forEach((genre)=> { %>
                    <option value="<%= genre.genre_id %>" <%= checkedGenreIds.includes(genre.genre_id) ? "selected" : "" %>>
                        <%= genre.genre_name %>
                    </option>
                    <% }) %>
            </select>

            <p>Hold Ctrl (Windows/Linux) or Command (Mac) to select multiple genres.</p>
        </div>

        <div>
            <label for="release_year">Release Year:</label>
            <input type="number" id="release_year" name="release_year" min="1950" max="2100" step="1" value="<%= game?.release_year ?? "" %>">
        </div>

        <button type="submit"><%= game ? "Update Game" : "Add Game" %></button>
    </form>

    <% if (game) { %>
        <p><a href="/games/<%= game.id %>">Back to game</a></p>
        <% } %>
    <p><a href="/games">Back to games</a></p>

</body>

</html>
