<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>Games</title>
</head>

<body>
    <h2>Genres</h2>
    <ul>
        <% genres.forEach((genre)=> { %>
            <li>
                <a href="/genres/<%= genre.genre_id %>">
                    <%= genre.genre_name %>
                </a>
            </li>
            <% }) %>
    </ul>
    <h1>Games</h1>

    <% if (games.length===0) { %>
        <p>No games found.</p>
        <% } else { %>
            <ul>
                <% games.forEach((game)=> { %>
                    <li>
                        <a href="/games/<%= game.id %>">
                            <strong>
                                <%= game.title %>
                            </strong>
                        </a>
                        — $<%= game.price %>
                            (stock: <%= game.stock %>)
                                <a href="/games/<%= game.id %>/edit">Edit</a>
                            <% if (game.genres.length === 0) { %>
                                <span>Genres: none</span>
                            <% } else { %>
                                <span>
                                    Genres:
                                    <% game.genres.forEach((genre, index)=> { %>
                                        <a href="/genres/<%= genre.genre_id %>"><%= genre.genre_name %></a><%= index < game.genres.length - 1 ? "," : "" %>
                                    <% }) %>
                                </span>
                            <% } %>
                    </li>
                    <% }); %>
            </ul>
            <% } %>

    <p><a href="/games/new">Add a Game</a></p>
    <p><a href="/genres">All genres</a></p>
</body>

</html>
