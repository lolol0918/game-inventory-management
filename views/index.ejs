<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include("partials/head") %>
  <title>GameVault</title>
</head>

<body>
  <%- include("partials/header") %>

    <main>
      <section class="hero">
        <p class="eyebrow">YOUR COLLECTION, ORGANIZED</p>
        <h1>Every game.<br>One library.</h1>
        <p>
          Manage your collection, track ratings,
          and keep your inventory organized.
        </p>
        <a class="button" href="/games">Explore Library</a>
      </section>

      <section class="library">
        <div class="section-heading">
          <div>
            <p class="eyebrow">THE COLLECTION</p>
            <h2>Your game library</h2>
          </div>

          <a href="/games">View all games →</a>
        </div>

        <% if (typeof games !== 'undefined' && games.length > 0) { %>
          <div class="game-grid">
            <% games.forEach((game) => { %>
              <article class="game-card">
                <a class="game-card-link" href="/games/<%= game.id %>">
                  <div class="game-card-media">
                    <% if (game.image_url) { %>
                      <img src="<%= game.image_url %>" alt="<%= game.title %>" loading="lazy"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                      <div class="game-card-fallback" style="display:none;"><%= game.title %></div>
                    <% } else { %>
                      <div class="game-card-fallback"><%= game.title %></div>
                    <% } %>
                  </div>
                  <div class="game-card-body">
                    <h3><%= game.title %></h3>
                    <% if (game.genres && game.genres.length > 0) { %>
                      <div class="meta">Genres: <%= game.genres.map(g => g.genre_name).join(', ') %></div>
                    <% } %>
                    <% if (game.rating !== null && game.rating !== undefined && game.rating !== '') { %>
                      <div class="meta">Rating: <%= game.rating %></div>
                    <% } %>
                    <% if (game.price !== null && game.price !== undefined && game.price !== '') { %>
                      <div class="price">$<%= game.price %></div>
                    <% } %>
                  </div>
                </a>
                <div class="game-card-actions">
                  <a class="button" href="/games/<%= game.id %>/edit">Edit</a>
                  <form action="/games/<%= game.id %>/delete" method="POST"
                    onsubmit="return confirm('Are you sure you want to delete this game?')">
                    <button type="submit">Delete</button>
                  </form>
                </div>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <p>No games found. <a href="/games/new">Add your first game</a>.</p>
        <% } %>
      </section>
    </main>
</body>

</html>