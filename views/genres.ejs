<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>Genres</title>
</head>

<body>
    <h1>Genres</h1>

    <ul>
        <% genres.forEach((genre)=> { %>
            <li>
                <a href="/genres/<%= genre.genre_id %>">
                    <%= genre.genre_name %>
                </a>
            </li>
            <% }) %>
    </ul>

    <p><a href="/genres/new">Add a Genre</a></p>
    <p><a href="/games">Back to games</a></p>
</body>

</html>
